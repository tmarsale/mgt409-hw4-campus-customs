# Copy this file to hw4/backend/.env and fill in your own values.
# Never commit the real .env file (it is listed in .gitignore).

# Required for the shopping assistant: your Portkey API key (AI calls are routed through Portkey).
PORTKEY_API_KEY=your-portkey-api-key-here

# Optional: the AI model name (default gpt-5.6-luna).
OPENAI_MODEL=gpt-5.6-luna

# Optional: use a different database file (default hw4/data/campus_customs.db).
# CAMPUS_CUSTOMS_DB=

# Optional: write the audit trail somewhere else (default hw4/output/audit_trail.json).
# CAMPUS_CUSTOMS_AUDIT=

# Optional: set to true when the site is served over HTTPS.
# COOKIE_SECURE=false
